# Per-audit working directories — generated per run, not committed
.audit-runs/

# Test fixture run outputs — regenerated by the pipeline
test-fixture/audit-runs/

# Synthetic iOS IPA — produced on demand by test-fixture/build_ios_fixture.py
test-fixture/ios-fixture/*.ipa

# Generated customer reports — committed only when explicitly published
reports/

# Customer build artifacts — never commit binaries
incoming/
*.apk
*.aab
*.ipa

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Secrets
.env
.env.*
*.pem
*.key
*.p12
*.keystore
