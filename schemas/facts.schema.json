{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "facts.schema.json",
  "title": "Audit Facts",
  "description": "Pinned codebase facts gathered deterministically by gather_facts.py from the workspace using real parsers (json.load for package.json/app.json, @expo/config for app.config.{js,ts}, tree-sitter-typescript queries for source-pattern counts — NEVER grep). Source of truth for every negative claim in the report per references.md Rule 1.3. Every count is the integer cardinality of an AST query result or a parsed-JSON field.",
  "type": "object",
  "required": ["audit_id", "facts_gathered_at", "project_signature"],
  "additionalProperties": false,
  "properties": {
    "audit_id": { "type": "string" },
    "facts_gathered_at": { "type": "string", "format": "date-time" },
    "workspace_root": { "type": "string", "description": "Absolute path to the ingested workspace/ directory." },

    "project_signature": {
      "type": "object",
      "description": "What kind of project this is. Drives which checks apply.",
      "additionalProperties": false,
      "properties": {
        "package_manager":         { "enum": ["npm", "yarn", "pnpm", "unknown"] },
        "expo_sdk_version":        { "type": ["string", "null"], "description": "Major version, e.g. '50', '51'." },
        "react_native_version":    { "type": ["string", "null"] },
        "react_version":           { "type": ["string", "null"] },
        "typescript_present":      { "type": "boolean" },
        "expo_router_present":     { "type": "boolean" },
        "react_navigation_present":{ "type": "boolean" },
        "hermes_enabled":          { "type": ["boolean", "null"], "description": "From app.json/app.config — null if not determinable (default for SDK depends on version)." },
        "new_architecture_enabled":{ "type": ["boolean", "null"] },
        "bundle_identifier_android":{ "type": ["string", "null"] },
        "bundle_identifier_ios":   { "type": ["string", "null"] }
      }
    },

    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "production_count":      { "type": "integer", "minimum": 0 },
        "dev_count":             { "type": "integer", "minimum": 0 },
        "expo_image_present":    { "type": "boolean", "description": "Is `expo-image` in dependencies (preferred over RN's <Image>)?" },
        "flash_list_present":    { "type": "boolean", "description": "Is `@shopify/flash-list` in dependencies (preferred over <FlatList> for long lists)?" },
        "reanimated_present":    { "type": "boolean", "description": "Is `react-native-reanimated` present (preferred over RN's Animated API)?" },
        "gesture_handler_present":{ "type": "boolean" },
        "screens_present":       { "type": "boolean", "description": "Is `react-native-screens` present (major nav perf)?" },
        "known_heavy_deps":      { "type": "array", "items": { "type": "string" }, "description": "Dependencies from a curated heavy-deps list that are present — moment, lodash (full), rxjs, three, chart.js, etc." }
      }
    },

    "source_pattern_counts": {
      "type": "object",
      "description": "AST-based counts from tree-sitter queries against workspace/ source files (.js/.jsx/.ts/.tsx). Each count is the number of distinct sites matching the pattern. ZERO is a meaningful value — it's what negative claims cite.",
      "additionalProperties": false,
      "properties": {
        "react_memo_count":              { "type": "integer", "minimum": 0, "description": "Calls to React.memo / memo()." },
        "use_memo_count":                { "type": "integer", "minimum": 0 },
        "use_callback_count":            { "type": "integer", "minimum": 0 },
        "use_effect_count":              { "type": "integer", "minimum": 0 },
        "use_effect_with_deps_count":    { "type": "integer", "minimum": 0, "description": "useEffect with a dependency array (any contents)." },
        "use_effect_empty_deps_count":   { "type": "integer", "minimum": 0, "description": "useEffect with []." },

        "scrollview_count":              { "type": "integer", "minimum": 0 },
        "flatlist_count":                { "type": "integer", "minimum": 0 },
        "sectionlist_count":             { "type": "integer", "minimum": 0 },
        "flashlist_count":               { "type": "integer", "minimum": 0 },

        "rn_image_usage_count":          { "type": "integer", "minimum": 0, "description": "<Image> from 'react-native'." },
        "expo_image_usage_count":        { "type": "integer", "minimum": 0, "description": "<Image> from 'expo-image'." },

        "console_log_count":             { "type": "integer", "minimum": 0 },
        "console_log_dev_guarded_count": { "type": "integer", "minimum": 0, "description": "console.log inside if (__DEV__) {...}." },

        "animated_rn_import_count":      { "type": "integer", "minimum": 0, "description": "Animated imports from 'react-native' (vs reanimated)." },
        "reanimated_import_count":       { "type": "integer", "minimum": 0 },

        "inline_arrow_renderitem_count": { "type": "integer", "minimum": 0, "description": "renderItem={() => ...} in FlatList/SectionList." },
        "inline_object_jsx_props_count": { "type": "integer", "minimum": 0, "description": "JSX attribute with ObjectExpression literal value (e.g. style={{...}})." }
      }
    },

    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image_asset_count":          { "type": "integer", "minimum": 0 },
        "image_asset_total_bytes":    { "type": "integer", "minimum": 0 },
        "images_over_500kb_count":    { "type": "integer", "minimum": 0 },
        "images_over_2mb_count":      { "type": "integer", "minimum": 0 },
        "png_count":                  { "type": "integer", "minimum": 0 },
        "webp_count":                 { "type": "integer", "minimum": 0 },
        "svg_count":                  { "type": "integer", "minimum": 0 }
      }
    },

    "presence": {
      "type": "object",
      "description": "Directory- and file-existence flags. Used by checks that need to know whether to skip / adapt.",
      "additionalProperties": false,
      "properties": {
        "app_dir_present":          { "type": "boolean", "description": "workspace/app/ (Expo Router)." },
        "src_dir_present":          { "type": "boolean" },
        "screens_dir_present":      { "type": "boolean" },
        "assets_dir_present":       { "type": "boolean" },
        "audit_overrides_present":  { "type": "boolean", "description": "workspace/.audit/ — user overrides." },
        "babel_config_present":     { "type": "boolean" },
        "metro_config_present":     { "type": "boolean" },
        "eas_json_present":         { "type": "boolean" },
        "ios_dir_present":          { "type": "boolean" },
        "android_dir_present":      { "type": "boolean" }
      }
    },

    "tooling_status": {
      "type": "object",
      "description": "Results from running tooling that informs facts (expo-doctor, npm audit, depcheck, madge). Stored here so report's negative claims about tooling can ground in these values.",
      "additionalProperties": false,
      "properties": {
        "expo_doctor_pass_count":   { "type": "integer", "minimum": 0 },
        "expo_doctor_fail_count":   { "type": "integer", "minimum": 0 },
        "circular_dependency_count":{ "type": "integer", "minimum": 0, "description": "From madge --circular." },
        "unused_dependency_count":  { "type": "integer", "minimum": 0, "description": "From depcheck." },
        "outdated_dependency_count":{ "type": "integer", "minimum": 0, "description": "From npm-check-updates." },
        "npm_audit_high_count":     { "type": "integer", "minimum": 0 },
        "npm_audit_critical_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
